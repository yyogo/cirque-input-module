menuconfig INPUT_PINNACLE_TOUCAN
    bool "Cirque Pinnacle trackpads (Toucan fork)"
    default y
    depends on GPIO
    depends on SPI || I2C
    depends on INPUT
    depends on DT_HAS_CIRQUE_PINNACLE_TOUCAN_ENABLED
    help
      Enable the Toucan-forked Cirque Pinnacle trackpad driver. Distinct
      from Zephyr 4.1's upstream INPUT_PINNACLE driver; this fork uses
      compatible "cirque,pinnacle-toucan" and a different overlay
      property set (tap-fast, smoothing-strength, abs-rel-divisor, etc.).

if INPUT_PINNACLE_TOUCAN

config INPUT_PINNACLE_TOUCAN_INIT_PRIORITY
    int "Cirque Pinnacle initialization priority"
    default INPUT_INIT_PRIORITY

config INPUT_PINNACLE_TOUCAN_PROFILE_DUMP
    bool "Dump raw Pinnacle samples over the console (profiling mode)"
    default n
    help
      When enabled, the driver bypasses all post-processing
      (smoothing, abs-rel divisor, tap-fast, lookahead) and prints
      one CSV row per chip sample to the system console:
        t_ms,btn,x,y,z
      Forces the chip into absolute-mode reporting regardless of
      DT settings so the dump always carries raw positions. Intended
      for offline analysis of trackpad behavior; do not ship.

if ZMK_MOUSE

config ZMK_INPUT_PINNACLE_TOUCAN_IDLE_SLEEPER
    bool "Pinnacle Sleep linked to ZMK idle state"
    default n

endif

endif
